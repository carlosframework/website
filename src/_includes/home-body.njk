<figure class="stack after"><ul role="list" aria-label="{{ t('stacks.after.aria') }}"><li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="3"/><rect x="9" y="9" width="6" height="6" rx="1"/></svg><span>{{ t('stacks.after.app') }}</span></li><li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 3 8l9 5 9-5zM3 12l9 5 9-5M3 16l9 5 9-5"/></svg><span>{{ t('stacks.after.platform') }}</span></li><li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 18a4 4 0 0 1-.5-7.97A5.5 5.5 0 0 1 17 8.5a4.75 4.75 0 0 1 0 9.5z"/></svg><span>{{ t('stacks.after.base') }}</span></li></ul><figcaption>With CARLOS</figcaption></figure>
