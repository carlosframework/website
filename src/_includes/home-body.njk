<section class="rw-get" aria-labelledby="rw-get-title"><div class="rw-wrap">
  <h2 id="rw-get-title">{{ t('get.heading') }}</h2>
  <div class="rw-three">
{%- for k in ['ship', 'build', 'save'] %}
    <article class="rw-out">
      <h3>{{ t('get.' + k + '.title') }}</h3>
{%- if figures %}
      <p class="rw-fig" data-count-from="{{ countFrom[k] }}"><span class="rw-fig-final">{{ t('get.' + k + '.figure') }}</span><span class="rw-fig-run" aria-hidden="true"></span></p>
      <p class="rw-fig-note">{{ t('get.' + k + '.figure.note') }}</p>
{%- else %}
      <p class="rw-alt">{{ t('get.' + k + '.alt') }}</p>
      <p class="rw-alt-note">{{ t('get.' + k + '.alt.note') }}</p>
{%- endif %}
      <ul><li>{{ t('get.' + k + '.item1') }}</li><li>{{ t('get.' + k + '.item2') }}</li><li>{{ t('get.' + k + '.item3') }}</li></ul>
    </article>
{%- endfor %}
  </div>

  <div class="rw-less">
    <h3>{{ t('stacks.heading') }}<span>{{ t('stacks.sub') }}</span></h3>
    <div class="ipx"><article class="ipanel wobble pyramid" data-glow="n2" data-mode="tower">
<div class="ihead"><span class="seg" role="group" aria-label="{{ t('stacks.toggle.aria') }}" hidden><button type="button" data-mode-set="tower" aria-pressed="true">{{ t('stacks.toggle.tower') }}</button><button type="button" data-mode-set="services" aria-pressed="false">{{ t('stacks.toggle.services') }}</button></span>
<button type="button" class="ipause" data-pause="{{ t('replay.pause') }}" data-play="{{ t('replay.play') }}" hidden>{{ t('replay.pause') }}</button>
<button type="button" class="ireset" hidden>{{ t('stacks.reset') }}</button></div>
<div class="istage">
<svg class="strings" aria-hidden="true" focusable="false"></svg>
<figure class="stack before tower"><ul role="list" aria-label="{{ t('stacks.tower.aria') }}"><li class="pair-a"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 7.5h.01M7 16.5h.01"/></svg><span>{{ t('stacks.tower.app-backend') }}</span></li><li class="pair-b"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M7 6.5h.01M10 6.5h.01"/></svg><span>{{ t('stacks.tower.app-frontend') }}</span></li><li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span>{{ t('stacks.tower.background-workers') }}</span></li><li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg><span>{{ t('stacks.tower.web-server') }}</span></li><li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h4l3-8 4 16 3-8h4"/></svg><span>{{ t('stacks.tower.observability-layer') }}</span></li><li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9zM4 7.5l8 4.5 8-4.5M12 12v9"/></svg><span>{{ t('stacks.tower.containers') }}</span></li>
{%- for k in range(6) %}<li class="micro" data-k="{{ k }}" style="--k:{{ k }}"{% if k == 5 %} data-label="{{ t('stacks.tower.microservices') }}"{% endif %}{% if k == 0 %}><span class="sr">{{ t('stacks.tower.microservices') }}</span>{% else %} aria-hidden="true">{% endif %}</li>{% endfor -%}
<li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="2.5"/><circle cx="12" cy="4" r="1.5"/><circle cx="5" cy="18" r="1.5"/><circle cx="19" cy="18" r="1.5"/><path d="M12 5.5v4M10 13.7 6.2 17M14 13.7l3.8 3.3"/></svg><span>{{ t('stacks.tower.cluster-orchestrator') }}</span></li><li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 7.5h.01M7 16.5h.01"/></svg><span>{{ t('stacks.tower.app-server') }}</span></li><li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/></svg><span>{{ t('stacks.tower.database-server') }}</span></li><li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M13 3 5 13h6l-1 8 8-10h-6z"/></svg><span>{{ t('stacks.tower.memory-cache') }}</span></li><li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v5M12 9 5 15M12 9l7 6M12 9v10M5 15v4M19 15v4"/></svg><span>{{ t('stacks.tower.load-balancer') }}</span></li><li class="base"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 18a4 4 0 0 1-.5-7.97A5.5 5.5 0 0 1 17 8.5a4.75 4.75 0 0 1 0 9.5z"/></svg><span>{{ t('stacks.tower.base') }}</span></li></ul><figcaption>Before CARLOS</figcaption></figure>
<figure class="stack before services"><ul role="list" aria-label="{{ t('stacks.services.aria') }}">
