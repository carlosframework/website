{#
  🤖 The documentation shell: sidebar, section sub-nav, article column.

  One layout serves the index and every page, because they share the
  whole chrome. The docs use no browser JavaScript.
  There is no search box, and findability is the nav, the card
  index, and the per-page section list.

  The sidebar precedes the article in document order, which on a narrow
  viewport is what puts the nav above the content without a toggle.

  The sidebar is a <nav>, not an <aside>: with no search, it IS this
  site's whole navigation model, not supplementary content. The article
  is wrapped in <main> so the skip link (first focusable element in
  <body>) has a landmark to target — with 40+ sidebar links ahead of it
  on every page, a keyboard user needs a way past them.
#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#101c23">
<title>{{ title }} &middot; CARLOS docs</title>
<meta name="description" content="{{ description }}">
<link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml">
<meta property="og:title" content="{{ title }} &middot; CARLOS docs">
<meta property="og:description" content="{{ description }}">
<meta property="og:type" content="article">
<meta property="og:url" content="https://carlosframework.com/docs/{% if not isIndex %}{{ docsSlug }}/{% endif %}">
<meta property="og:image" content="https://carlosframework.com/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="CARLOS. Build better. Demand better.">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="https://carlosframework.com/og-image.png">
<link rel="stylesheet" href="/site.css?v=0">
<link rel="stylesheet" href="/docs.css?v=0">
<link rel="stylesheet" href="/header.css?v=0">
<script src="/docs-nav.js?v=0" defer></script>
<script src="/docs-search.js?v=0" defer></script>
<script src="/docs-stepper.js?v=0" defer></script>
</head>
<body class="docs-body">
<a class="skip-link visually-hidden" href="#main">Skip to content</a>
<header class="masthead">
  <a class="mark" href="/"><svg class="wordmark" viewBox="11 11 499 118" width="79" height="18" fill="none" stroke="currentColor" stroke-width="18" role="img" aria-label="CARLOS"><path transform="translate(0,0)" d="M77,44 A20,20 0 0 0 57,24 H43 A20,20 0 0 0 23,44 V96 A20,20 0 0 0 43,116 H57 A20,20 0 0 0 77,96"/><path transform="translate(86,0)" d="M25,117 L45,23 H55 L75,117 M33,80 H67"/><path transform="translate(172,0)" d="M23,117 V23 H53 A23,23 0 0 1 53,69 H23 M50,69 L77,117"/><path transform="translate(258,0)" d="M23,23 V117 H77"/><path transform="translate(335,0)" d="M23,44 A20,20 0 0 1 43,24 H57 A20,20 0 0 1 77,44 V96 A20,20 0 0 1 57,116 H43 A20,20 0 0 1 23,96 Z"/><path transform="translate(421,0)" d="M77,39 A16,16 0 0 0 61,23 H39 A16,16 0 0 0 23,39 V54 A16,16 0 0 0 39,70 H61 A16,16 0 0 1 77,86 V101 A16,16 0 0 1 61,117 H39 A16,16 0 0 1 23,101 V98"/></svg></a>
  <nav aria-label="Site">
    <a href="/apps/">Apps</a>
    <a href="/trust/">Trust</a>
    <a href="/platform/" aria-current="true">Platform</a>
    <a href="/start/">Get started</a>
  </nav>
</header>

<div class="docs-shell{% if not isIndex %} has-toc{% endif %}">
  <nav class="docs-nav" aria-label="Documentation">
    <div class="nav-head">
      <p class="docs-nav-title"><a href="/platform/">CARLOS Platform</a></p>
      <p class="docs-nav-title"><a href="/docs/"{% if isIndex %} class="active" aria-current="page"{% endif %}>Documentation</a></p>
      <a class="docs-search" href="/docs/#every-page"><svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M11 11 L14.5 14.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><span>Search the docs</span><kbd title="Press / to search">/</kbd></a>
    </div>
    <div class="nav-groups">
      {% for section in docsnav.sections %}
      <div class="nav-group{% if section | docsSectionHas(docsSlug) %} is-current{% endif %}">
        <a class="docs-nav-section" href="/docs/#{{ section.title | docsSlugify }}">{{ section.title }}</a>
        <ul>
          {% for entry in section.pages %}
          <li><a href="/docs/{{ entry.slug }}/"{% if entry.slug == docsSlug %} class="active" aria-current="page"{% endif %}>{{ entry.label }}</a></li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
      <div class="nav-group nav-extra">
        <a class="docs-nav-section" href="/platform/changelog/">Changelog</a>
      </div>
    </div>
  </nav>

  <main id="main">
    <article class="docs-article">
      {{ content | safe }}

      {% if not isIndex %}
      <p class="docs-foot">
        <a href="/docs/{{ docsSlug }}.md">Read this page as markdown</a> —
        exact, unstyled, and cheap for an agent to fetch.
      </p>
      {% endif %}
    </article>
  </main>

  {% if not isIndex %}
  {% set sections = collections.docs | docsRawFor(docsSlug) | docsSections %}
  {% if sections.length %}
  <aside class="docs-toc" aria-label="On this page">
    <p class="docs-toc-title">On this page</p>
    <ul>
      {% for s in sections %}<li><a href="#{{ s.anchor }}">{{ s.title }}</a></li>{% endfor %}
    </ul>
  </aside>
  {% endif %}
  {% endif %}
</div>

<footer class="site-footer">
  <p class="docs-provenance">Documented from <a href="https://github.com/carlosframework/platform">carlosframework/platform</a> at <code>{{ docsversion.short }}</code>. Every claim on these pages is checked against that source by tests in that repo.</p>
</footer>
</body>
</html>
