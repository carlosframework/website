---
permalink: /platform/changelog/index.html
eleventyExcludeFromCollections: true
---
{#
  🤖 The platform changelog. Every release, newest first: its published
  notes, then every change that landed in it.

  The data is src/_data/docschangelog.json, vendored by
  hack/sync-docs.mjs from the platform repo's docs/site/changelog.json,
  which that repo's cmd/changelog generates and its Go tests gate. Edit
  neither here: regenerate in the platform repo and re-sync.

  The change lines are records, quoted from the commit history, and
  styled as data (mono). The page's own framing is reviewed copy.
#}
{%- set cl = docschangelog -%}
{%- set limit = 25 -%}
{%- macro credit(list) -%}
{%- for c in list -%}
{%- if c.person -%}{{ c.person }}{%- if c.agents %} with {{ c.agents | join(", ") }}{% endif -%}
{%- else -%}{{ c.agents | join(", ") }}{%- endif -%}
{%- if not loop.last %} · {% endif -%}
{%- endfor -%}
{%- endmacro -%}
{%- macro change(ch, repo) -%}
<li class="change">
  <p class="what">
    {%- if ch.branch_url %}<a class="branch" href="{{ ch.branch_url }}">{{ ch.branch }}</a>{% elif ch.branch %}<span class="branch">{{ ch.branch }}</span>{% endif -%}
    <span class="subject">{{ ch.subject }}</span>
  </p>
  <p class="refs">
    <span class="credit">{{ credit(ch.credit) }}</span>
    {%- for d in ch.discussions %} <a class="disc" href="{{ repo }}/-/discussion/{{ d.id }}" title="{{ d.title }}">#{{ d.id }}</a>{% endfor -%}
    {%- for href in ch.docs %} <a class="doc" href="{{ href }}">{{ href | docsLabel }}</a>{% endfor %}
    <a class="sha" href="{{ repo }}/commit/{{ ch.sha }}">{{ ch.sha | truncate(8, true, "") }}</a>
  </p>
</li>
{%- endmacro -%}
{%- macro bullet(b, repo) -%}
<li>
  {{ b.md | notesMdInline | safe }}
  {%- if b.branches or b.docs %}
  <span class="links">
    {%- for br in b.branches %} <a class="branch" href="{{ repo }}/-/branch/{{ br | urlencode }}">{{ br }}</a>{% endfor -%}
    {%- for href in b.docs %} <a class="doc" href="{{ href }}">{{ href | docsLabel }}</a>{% endfor -%}
  </span>
  {%- endif %}
</li>
{%- endmacro -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Changelog · the CARLOS platform</title>
<meta name="description" content="🤖 Every release of the CARLOS platform, every change that landed in it, and who did the work.">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0a0c10" media="(prefers-color-scheme: dark)">
<meta property="og:title" content="Changelog · the CARLOS platform">
<meta property="og:description" content="Every release of the CARLOS platform, every change that landed in it, and who did the work.">
<meta property="og:type" content="website">
<meta property="og:url" content="https://carlosframework.com/platform/changelog/">
<link rel="stylesheet" href="/site.css?v=0">
<style>
  :root {
    --accent: #0d5f88;
    --accent-deep: #094761;
    --accent-soft: rgba(13, 95, 136, 0.10);
    --on-accent: #ffffff;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --accent: #59bfe8;
      --accent-deep: #93d8f5;
      --accent-soft: rgba(89, 191, 232, 0.13);
      --on-accent: #04202e;
    }
  }
  .releases-toc { display: flex; flex-wrap: wrap; gap: 0.35rem 0.9rem; margin-top: 2rem; font-family: var(--font-mono); font-size: 0.85rem; }
  .releases-toc a { text-decoration: none; }
  .releases-toc a:hover { text-decoration: underline; }
  main > section.release { padding-block: clamp(2.5rem, 5vw, 3.75rem); scroll-margin-top: 1rem; }
  .release > .head { margin-bottom: 1.5rem; }
  .release h2 { font-family: var(--font-mono); font-size: clamp(1.45rem, 2.6vw, 1.9rem); letter-spacing: -0.02em; }
  .release h2 a { color: inherit; text-decoration: none; }
  .release h2 a:hover { color: var(--accent); }
  .release .meta { margin-top: 0.5rem; color: var(--muted); font-size: 0.92rem; }
  .release .meta time { font-family: var(--font-mono); font-size: 0.86rem; }
  .notes { max-width: 46rem; }
  .notes > ul { padding-left: 1.1rem; display: grid; gap: 0.7rem; }
  .notes li { color: var(--ink-2); }
  .notes details { margin-top: 1.25rem; }
  .notes details > ul { padding-left: 1.1rem; display: grid; gap: 0.7rem; margin-top: 0.85rem; }
  .notes summary { cursor: pointer; font-weight: 600; color: var(--ink); }
  .notes .markdown { margin-top: 0.85rem; color: var(--ink-2); }
  .notes .markdown h4, .notes .markdown h5, .notes .markdown h6 { margin-top: 1.4rem; font-size: 1rem; color: var(--ink); }
  .notes .markdown p, .notes .markdown ul, .notes .markdown ol, .notes .markdown pre, .notes .markdown table { margin-top: 0.7rem; }
  .notes .markdown ul, .notes .markdown ol { padding-left: 1.1rem; }
  .notes .markdown pre { overflow-x: auto; padding: 0.75rem 0.9rem; background: var(--bg-sunk); border-radius: 6px; }
  .notes .markdown pre code { background: none; padding: 0; }
  .notes .markdown table { border-collapse: collapse; font-size: 0.9rem; }
  .notes .markdown th, .notes .markdown td { border-top: 1px solid var(--rule); padding: 0.35rem 0.75rem 0.35rem 0; text-align: left; vertical-align: top; }
  .links { display: inline; }
  .links a, .refs a { font-family: var(--font-mono); font-size: 0.78rem; white-space: nowrap; }
  .links a.branch, .refs a.doc, .links a.doc { margin-left: 0.5rem; }
  .changes-head { margin-top: 2.25rem; display: flex; gap: 0.6rem; align-items: baseline; }
  .changes-head .count { color: var(--muted); font-family: var(--font-mono); font-size: 0.86rem; }
  .changes { list-style: none; margin-top: 0.85rem; border-top: 1px solid var(--rule-soft); }
  .change { padding-block: 0.7rem; border-bottom: 1px solid var(--rule-soft); }
  .change .what { display: flex; flex-wrap: wrap; gap: 0.15rem 0.75rem; align-items: baseline; }
  .change .branch { font-family: var(--font-mono); font-size: 0.82rem; font-weight: 600; }
  .change span.branch { color: var(--muted); }
  .change .subject { font-family: var(--font-mono); font-size: 0.82rem; color: var(--ink); overflow-wrap: anywhere; }
  .change .refs { margin-top: 0.3rem; display: flex; flex-wrap: wrap; gap: 0.2rem 0.75rem; align-items: baseline; font-size: 0.84rem; color: var(--muted); }
  .change .refs .sha { margin-left: auto; color: var(--muted); }
  .change .refs .sha:hover { color: var(--accent); }
  .more { margin-top: 0.85rem; }
  .more summary { cursor: pointer; color: var(--accent); font-size: 0.92rem; }
  .empty { margin-top: 0.85rem; color: var(--muted); }
</style>
</head>
<body>
<header class="masthead">
  <a class="mark" href="/"><svg class="wordmark" viewBox="11 11 518 118" width="79" height="18" fill="none" stroke="currentColor" stroke-width="18" role="img" aria-label="CARLOS"><path transform="translate(0,0)" d="M77,44 A20,20 0 0 0 57,24 H43 A20,20 0 0 0 23,44 V96 A20,20 0 0 0 43,116 H57 A20,20 0 0 0 77,96"/><path transform="translate(88,0)" d="M25,117 L45,23 H55 L75,117 M33,80 H67"/><path transform="translate(176,0)" d="M23,117 V23 H53 A23,23 0 0 1 53,69 H23 M50,69 L77,117"/><path transform="translate(264,0)" d="M23,23 V117 H77"/><path transform="translate(352,0)" d="M23,44 A20,20 0 0 1 43,24 H57 A20,20 0 0 1 77,44 V96 A20,20 0 0 1 57,116 H43 A20,20 0 0 1 23,96 Z"/><path transform="translate(440,0)" d="M77,39 A16,16 0 0 0 61,23 H39 A16,16 0 0 0 23,39 V54 A16,16 0 0 0 39,70 H61 A16,16 0 0 1 77,86 V101 A16,16 0 0 1 61,117 H39 A16,16 0 0 1 23,101 V98"/></svg></a>
  <nav aria-label="Site">
    <a href="/apps/">Apps</a>
    <a href="/trust/">Trust</a>
    <a href="/platform/" aria-current="page">Platform</a>
    <a href="/docs/">Docs</a>
    <a href="/start/">Get started</a>
  </nav>
</header>

<div class="hero">
  <h1>Changelog</h1>

  <p class="lede">Every release of the platform, newest first. Under each release's notes is every change that landed in it: one line per merged branch, linked to its branch and discussions on Amadan, where the platform is developed, and naming the people and agents who did the work.</p>

  <p class="note">The change lines are quoted from the history as they were written. Every change from v0.19.0 on links to its branch. Before that, most work was merged on GitHub, where the repository is private, so those changes link only to their commit.</p>

  <p class="robot">🤖 This page was written by an LLM, on the ideas, instruction, and editing of humans. AI-written text here is always marked, visibly, like this. That's <a href="https://11factor.org/#x">factor X</a>.</p>

  <nav class="releases-toc" aria-label="Releases">
    {%- for r in cl.releases %}<a href="#{{ r.tag | releaseId }}">{{ r.tag }}</a>{% endfor -%}
  </nav>
</div>

<main>
{% for r in cl.releases %}
<section class="release" id="{{ r.tag | releaseId }}">
  <div class="head">
    <h2><a href="#{{ r.tag | releaseId }}">{{ r.tag }}</a></h2>
    <p class="meta"><time datetime="{{ r.date }}">{{ r.date }}</time> · {% if r.published %}<a href="{{ r.notes_url }}">Release notes and downloads</a>{% else %}Tagged, never published{% endif %}</p>
  </div>

  {%- if r.notes %}
  <div class="notes">
    {%- if r.notes.form == "bullets" %}
    {%- for s in r.notes.sections %}
    {%- if s.title %}
    <details>
      <summary>{{ s.title }}</summary>
      <ul>{% for b in s.bullets %}{{ bullet(b, cl.repo) }}{% endfor %}</ul>
    </details>
    {%- else %}
    <ul>{% for b in s.bullets %}{{ bullet(b, cl.repo) }}{% endfor %}</ul>
    {%- endif %}
    {%- endfor %}
    {%- else %}
    <details>
      <summary>Release notes</summary>
      <div class="markdown">{{ r.notes.md | notesMd | safe }}</div>
    </details>
    {%- endif %}
  </div>
  {%- endif %}

  <div class="changes-head"><h3>Changes</h3><span class="count">{{ r.changes.length }}</span></div>
  {%- if r.changes.length == 0 %}
  <p class="empty">No changes of its own.</p>
  {%- else %}
  <ol class="changes">
    {%- for ch in r.changes %}{% if loop.index0 < limit %}{{ change(ch, cl.repo) }}{% endif %}{% endfor %}
  </ol>
  {%- if r.changes.length > limit %}
  <details class="more">
    <summary>{{ r.changes.length - limit }} more</summary>
    <ol class="changes">
      {%- for ch in r.changes %}{% if loop.index0 >= limit %}{{ change(ch, cl.repo) }}{% endif %}{% endfor %}
    </ol>
  </details>
  {%- endif %}
  {%- endif %}
</section>
{% endfor %}
</main>

<footer>
  <p>🤖 Written by an LLM (Claude), on the ideas, instruction, and editing of humans. AI-written text here is always marked and always disclosed; see <a href="https://11factor.org/#x">factor X</a>.</p>
  <p>The platform runs apps built on <a href="/">the CARLOS framework</a>, keeping the promises set out in <a href="https://11factor.org">The Eleven Factors</a>. <a href="https://carloku.com">Carloku</a> is the flagship deployment, offered hosted.</p>
</footer>
</body>
</html>
