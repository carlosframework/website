---
layout: docs.njk
title: Documentation
description: "The CARLOS platform reference: the commands you type, and what happens on a box after you type them."
isIndex: true
permalink: /docs/index.html
---
{{ collections.docsIndex[0].templateContent | safe }}

{% for section in docsnav.sections %}
<h2 id="{{ section.title | docsSlugify }}">{{ section.title }}</h2>
<ul class="docs-cards">
  {% for entry in section.pages %}
  <li>
    <a href="/docs/{{ entry.slug }}/"><strong>{{ entry.label }}</strong></a>
    <span>{{ entry.blurb }}</span>
  </li>
  {% endfor %}
</ul>
{% endfor %}

<h2 id="every-page">Every page</h2>
<p>Browse the docs from A to Z.</p>
<ul class="docs-page-index">
  {% for entry in docsnav | docsAllPages %}
  <li><a href="/docs/{{ entry.slug }}/">{{ entry.label }}</a> <span>{{ entry.section }}</span></li>
  {% endfor %}
</ul>
