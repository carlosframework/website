    {
      "id": "replay.agent.q4",
      "text": "Have you built web apps before?",
      "original": "Have you built web apps before?",
      "edited": false,
      "rerolled": false,
      "rerolls": [],
      "done": false
    },
    {
      "id": "replay.you.2",
      "text": "I run a little bakery called Panadería Carlos. I’d like a page where customers can pre-order bread and cakes. … I want it to feel warm and friendly. I’m not technical, so keep it simple for me.",
      "original": "I run a little bakery called Panadería Carlos. I’d like a page where customers can pre-order bread and cakes. … I want it to feel warm and friendly. I’m not technical, so keep it simple for me.",
