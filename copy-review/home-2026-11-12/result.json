    {
      "id": "replay.agent.1",
      "text": "I’ve read the directions. They say to ask what you want before I build anything, so here are a few quick questions.",
      "original": "I’ve read the directions. They say to ask what you want before I build anything, so here are a few quick questions.",
      "edited": false,
