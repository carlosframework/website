    {
      "id": "replay.agent.q2",
      "text": "How should it feel?",
      "original": "How should it feel?",
      "edited": false,
      "rerolled": false,
      "rerolls": [],
      "done": false
    },
    {
      "id": "replay.agent.q3",
      "text": "What’s the main screen, and what’s the one kind of thing it saves?",
      "original": "What’s the main screen, and what’s the one kind of thing it saves?",
      "edited": false,
      "rerolled": false,
      "rerolls": [],
      "done": false
